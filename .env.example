# Copy to .env to override defaults. Every value here is a safe local default; no secrets needed.
# docker compose reads .env automatically. For `npm run dev`, export these or use your shell.

PORT=3000

# Product source: "fakestore" (live API) or "snapshot" (backend/data/fakestore-snapshot.json, works offline)
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com

# The products the business has chosen as "top rated", in display order
TOP_RATED_PRODUCT_IDS=3,5,11,12,18

CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000

# Email. Defaults point at Mailpit (inbox at http://localhost:8025).
# Inside docker compose SMTP_HOST is "mailpit"; for `npm run dev` use "localhost".
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Catalogue <no-reply@example.test>
SALES_INBOX=sales@example.test

# Enquiries allowed per client IP per window (default: 5 per 15 minutes)
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MS=900000

# debug | info | warn | error | silent
LOG_LEVEL=info
